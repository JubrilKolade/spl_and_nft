# Example Solana wallet keypair file path.
# Copy this file to .env and set KEYPAIR_PATH if you want to use a custom wallet.
# If not set, the script will use ~/.config/solana/id.json.
KEYPAIR_PATH=

# Optional: devnet, testnet, mainnet-beta
SOLANA_CLUSTER=devnet

# Optional: custom RPC endpoint
SOLANA_RPC_ENDPOINT=
